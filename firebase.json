{
  "firestore": {
    "rules": "firestore.rules.txt"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": [
    {
      "site": "ssr-team",
      "public": "frontend/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "site": "ssr-team-admin",
      "public": "admin/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ]
}